    "prepublishOnly": "npm run check",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axi-sdk-js": "^0.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
